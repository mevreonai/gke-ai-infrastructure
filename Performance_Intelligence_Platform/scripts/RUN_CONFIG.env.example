# ==============================================================================
# PERFORMANCE INTELLIGENCE PLATFORM — RUN CONFIGURATION REFERENCE
# ==============================================================================
# Copy this file to RUN_CONFIG.env and edit the values below.
#
# This config drives the ENTIRE benchmark pipeline: master runner (Steps 0-15),
# continuous batching (Step 17 / standalone), and the smoke test harness.
#
# USAGE:
#   cp RUN_CONFIG.env.example RUN_CONFIG.env
#   vim RUN_CONFIG.env          # Edit values
#   bash run_master_benchmark.sh --all
# ==============================================================================

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 1. CLUSTER NODE CONFIGURATION                                              │
# │    IPs and names for your GPU nodes. Update after creating VMs.             │
# └─────────────────────────────────────────────────────────────────────────────┘
export NODE0_IP="10.128.0.XX"             # Head node (serves vLLM)
export NODE1_IP="10.128.0.YY"             # Worker node (for PP/distributed)
export GPU_NODE0_NAME="v8-bench-node-0"   # GCE instance name for node 0
export GPU_NODE1_NAME="v8-bench-node-1"   # GCE instance name for node 1
export PROJECT_ID="your-gcp-project"      # GCP project ID
export ZONE0="us-central1-c"              # Zone for node 0
export ZONE1="us-central1-c"              # Zone for node 1
export SSH_KEY="$HOME/.ssh/google_compute_engine"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 2. ENVIRONMENT & PYTHON STACK                                              │
# │    Where the benchmark suite and vLLM virtualenv live on the GPU nodes.     │
# └─────────────────────────────────────────────────────────────────────────────┘
export BENCH_ROOT="$HOME/platform_bench_suite"
export VENV_DIR="$HOME/vllm_env"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 3. MODEL CONFIGURATION                                                     │
# │    Model-agnostic: change MODEL and REVISION for any HuggingFace model.     │
# │    These are overridable via CLI:  --model <id> --revision <sha>            │
# └─────────────────────────────────────────────────────────────────────────────┘
export MODEL="${MODEL:-moonshotai/Kimi-Linear-48B-A3B-Instruct}"
export REVISION="${REVISION:-e1df551a447157d4658b573f9a695d57658590e9}"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 4. SWEEP SELECTION FILTERS                                                 │
# │    Control which topologies, bandwidths, stages, and CB blocks to execute.  │
# │    Override via CLI (--topologies, --bandwidth, --stage) or set here.       │
# │                                                                             │
# │    ┌───────────────────────────────────────────────────────────────────┐     │
# │    │ TOPOLOGIES (comma-separated or "all"):                           │     │
# │    │   all       — Run every topology                                 │     │
# │    │   tp4_pp1   — 4-GPU tensor parallel, single pipeline             │     │
# │    │   tp8_pp1   — 8-GPU tensor parallel, single pipeline             │     │
# │    │   tp4_pp2   — 4-GPU TP x 2-way pipeline parallel (2 nodes)       │     │
# │    │   tp8_pp2   — 8-GPU TP x 2-way pipeline parallel (2 nodes)       │     │
# │    │   tp4_pp4   — 4-GPU TP x 4-way pipeline parallel                 │     │
# │    │   tp16_pp1  — 16-GPU tensor parallel (2 nodes, all GPUs)         │     │
# │    │                                                                   │     │
# │    │ Example: TOPOLOGY_SELECTION="tp4_pp1,tp4_pp2"                     │     │
# │    └───────────────────────────────────────────────────────────────────┘     │
# │    ┌───────────────────────────────────────────────────────────────────┐     │
# │    │ NETWORK BANDWIDTH (comma-separated or "all"):                    │     │
# │    │   all      — Test native + all impaired configurations           │     │
# │    │   native   — GCP native inter-node bandwidth                     │     │
# │    │   100g     — Simulated 100 Gbps cap                              │     │
# │    │   20g      — Simulated 20 Gbps cap (high contention)             │     │
# │    │   impaired — All throttled configurations                        │     │
# │    │                                                                   │     │
# │    │ Example: NETWORK_BANDWIDTH_SELECTION="native,100g"                │     │
# │    └───────────────────────────────────────────────────────────────────┘     │
# │    ┌───────────────────────────────────────────────────────────────────┐     │
# │    │ STAGES (single value or "all"):                                  │     │
# │    │   all  — Run Stages 1 + 2 + 3 (~7h 10m total)                   │     │
# │    │   1    — Quick Wins & Single-Node  (Steps 1-7, ~1h 10m)         │     │
# │    │   2    — Scale-Out & Async PP      (Steps 8-13, ~3h 30m)        │     │
# │    │   3    — Deep Profiling & Sweeps   (Steps 14-15, ~2h 30m)       │     │
# │    │                                                                   │     │
# │    │ Example: STAGE_SELECTION="1"                                      │     │
# │    └───────────────────────────────────────────────────────────────────┘     │
# └─────────────────────────────────────────────────────────────────────────────┘
export TOPOLOGY_SELECTION="${TOPOLOGY_SELECTION:-all}"
export NETWORK_BANDWIDTH_SELECTION="${NETWORK_BANDWIDTH_SELECTION:-all}"
export STAGE_SELECTION="${STAGE_SELECTION:-all}"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 5. HARDWARE & KERNEL EXECUTION CONTROLS                                    │
# │    Cutlass/Triton MoE tight invariants. DO NOT change unless you know       │
# │    exactly what you're doing.                                               │
# └─────────────────────────────────────────────────────────────────────────────┘
export CUDA_DEVICE_ORDER="PCI_BUS_ID"
export VLLM_MOE_BACKEND="triton"
export VLLM_FLASHINFER_AUTOTUNE="1"
export VLLM_FLASHINFER_AUTOTUNE_SKIP_OPS="trtllm::fused_moe::gemm1,trtllm::fused_moe::gemm2"
export VLLM_PP_LAYER_PARTITION="15,12"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 6. INTER-NODE NCCL & NETWORK PROVENANCE                                   │
# │    Controls NCCL transport and network provenance metadata. For 2-node      │
# │    setups, ens3 is the standard GCP internal NIC.                          │
# └─────────────────────────────────────────────────────────────────────────────┘
export NCCL_SOCKET_IFNAME="ens3"
export NCCL_NET="Socket"
export NCCL_CROSS_NIC="0"
export NCCL_ALGO="Tree"
export NCCL_PROTO="Simple"
export NCCL_BUFFSIZE="4194304"
export V8_GCP_NETWORK_PROVENANCE_OVERRIDE="GCP_NATIVE"
export GCP_NETWORK_PROVENANCE="GCP_NATIVE"
export V8_VLLM_NETWORK_MODE="native"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 7. SERVICE ENDPOINTS                                                       │
# │    vLLM server host/worker host. Usually matches NODE0/NODE1.              │
# └─────────────────────────────────────────────────────────────────────────────┘
export VLLM_HOST="$NODE0_IP"
export VLLM_WORKER_HOST="$NODE1_IP"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 8. OBSERVABILITY, WAVES, STALLS & PAUSE DETECTION                         │
# │    Controls logging granularity and metric percentile collection.           │
# └─────────────────────────────────────────────────────────────────────────────┘
export VLLM_LOG_STATS_INTERVAL="1"
export TORCH_LOGS="recompiles"
export PYTHONUNBUFFERED="1"
export VLLM_METRIC_PERCENTILES="50,95,99,100"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 9. CONTINUOUS BATCHING SWEEP CONFIGURATION (Task 2 / Step 17)              │
# │                                                                             │
# │    Select blocks to run: "all" or comma-separated list of block numbers.    │
# │    ┌───────────────────────────────────────────────────────────────────┐     │
# │    │ Block 1: Long Prompts Side-by-Side (Chunk cap vs big step)       │     │
# │    │ Block 2: Step Budget Sweep (4K, 8K, 16K, 32K on TP4/PP1 & PP2)  │     │
# │    │ Block 3: Request Cap Binding (max-num-seqs 16, 32, 64)           │     │
# │    │ Block 4: Mixed Traffic (short + long concurrent streams)         │     │
# │    │ Block 5: Memory Pressure (KV cache limits under load)            │     │
# │    │ Block 6: Long Answers (1024, 2048 decode token scaling)          │     │
# │    │ Block 7: Steady Arrivals (Poisson/fixed-rate on 2 servers)       │     │
# │    │                                                                   │     │
# │    │ Examples:                                                         │     │
# │    │   CB_BLOCKS="all"       — Run all 7 blocks                       │     │
# │    │   CB_BLOCKS="1,2,3"     — Run only blocks 1, 2, and 3            │     │
# │    │   CB_BLOCKS="4"         — Run only mixed traffic block            │     │
# │    └───────────────────────────────────────────────────────────────────┘     │
# └─────────────────────────────────────────────────────────────────────────────┘
export CB_BLOCKS="all"
