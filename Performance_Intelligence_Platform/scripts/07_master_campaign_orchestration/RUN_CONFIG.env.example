# ==============================================================================
# PERFORMANCE INTELLIGENCE PLATFORM — RUN CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to RUN_CONFIG.env and adjust to match your cluster topology.

# 1. Cluster Node Configuration
export NODE0_IP="10.128.0.39"
export NODE1_IP="10.128.0.40"
export GPU_NODE0_NAME="kimi-node-0"
export GPU_NODE1_NAME="kimi-node-1"
export PROJECT_ID="mevreon"
export ZONE0="us-central1-b"
export ZONE1="us-central1-b"
export SSH_KEY="$HOME/.ssh/google_compute_engine"

# 2. Environment & Python Stack
export BENCH_ROOT="$HOME/v8_additional_runs_suite"
export VENV_DIR="$HOME/vllm_env"

# 3. Model Configuration (Agnostic — can be overridden for any model)
export MODEL="${MODEL:-moonshotai/Kimi-Linear-48B-A3B-Instruct}"
export REVISION="${REVISION:-e1df551a447157d4658b573f9a695d57658590e9}"

# 4. Hardware & Kernel Execution Controls
export CUDA_DEVICE_ORDER="PCI_BUS_ID"
export VLLM_MOE_BACKEND="triton"
export VLLM_FLASHINFER_AUTOTUNE="1"
export VLLM_FLASHINFER_AUTOTUNE_SKIP_OPS="trtllm::fused_moe::gemm1,trtllm::fused_moe::gemm2"
export VLLM_PP_LAYER_PARTITION="15,12"

# 5. Inter-Node NCCL & Network Provenance
export NCCL_SOCKET_IFNAME="ens3"
export NCCL_NET="Socket"
export NCCL_CROSS_NIC="1"
export NCCL_BUFFSIZE="4194304"
export V8_GCP_NETWORK_PROVENANCE_OVERRIDE="GCP_NATIVE"
export GCP_NETWORK_PROVENANCE="GCP_NATIVE"
export V8_VLLM_NETWORK_MODE="native"

# 6. Service Endpoints
export VLLM_HOST="$NODE0_IP"
export VLLM_WORKER_HOST="$NODE1_IP"
