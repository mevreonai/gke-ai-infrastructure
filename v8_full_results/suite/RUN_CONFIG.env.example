# ==============================================================================
# V8 BENCHMARK SUITE — IP & CLUSTER CONFIGURATION TEMPLATE
# ==============================================================================
# QUICKSTART GUIDE:
# 1. Copy this file to RUN_CONFIG.env:
#      cp RUN_CONFIG.template.env RUN_CONFIG.env
# 2. Open RUN_CONFIG.env and edit the two IP addresses below:
#      NODE0_IP="<Your-Node-0-Private-IP>"
#      NODE1_IP="<Your-Node-1-Private-IP>"
# 3. Run the master benchmark suite:
#      bash 00_run_master_additional_runs.sh
# ==============================================================================

# Node 0 (Primary Head Node IP where this script runs)
export NODE0_IP="10.240.0.10"

# Node 1 (Secondary Worker Node IP)
export NODE1_IP="10.240.0.11"

# Cluster Hostnames
export GPU_NODE0_NAME="kimi-node-0"
export GPU_NODE1_NAME="kimi-node-1"

# Google Cloud Platform Zone & Project (Optional)
export PROJECT_ID="mevreon"
export ZONE0="us-central1-b"
export ZONE1="us-central1-b"
export SSH_KEY="$HOME/.ssh/google_compute_engine"

# Benchmark Workspace Paths on the Cloud VMs
export BENCH_ROOT="$HOME/rtx_g4_smoke"
export VENV_DIR="$HOME/vllm_env"

# Inter-Node Network Transport Settings (Google Cloud Andromeda VPC)
export NCCL_SOCKET_IFNAME="ens3"
export NCCL_NET="Socket"
export NCCL_CROSS_NIC="1"
export NCCL_BUFFSIZE="4194304"

# Host aliases consumed by vLLM & Ray
export VLLM_HOST="$NODE0_IP"
export VLLM_WORKER_HOST="$NODE1_IP"

# Architecture, Kernel Backends & Scale-Out Policies
export CUDA_DEVICE_ORDER="PCI_BUS_ID"
export VLLM_MOE_BACKEND="triton"
export VLLM_FLASHINFER_AUTOTUNE="1"
export VLLM_PP_LAYER_PARTITION="15,12"
export V8_GCP_NETWORK_PROVENANCE_OVERRIDE="GCP_NATIVE"
export V8_VLLM_NETWORK_MODE="native"

